{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/coralehr/fhir-mcp-eval/schemas/public_eval_item_v1.schema.json",
  "title": "Privacy-minimized public evaluation item",
  "description": "Opaque identifiers, receipts, scores, economics, and restricted-source bindings for one question-arm result. Raw clinical text, prompts, answers, and traces are outside this public contract.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_id",
    "experiment_id",
    "question_id",
    "cluster_id",
    "arm_id",
    "grading_id",
    "evidence",
    "execution",
    "outcome",
    "grading",
    "economics",
    "privacy"
  ],
  "properties": {
    "schema_version": { "const": "public-eval-item-v1" },
    "record_id": { "type": "string", "pattern": "^pubitem_[0-9a-f]{24}$" },
    "experiment_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{1,79}$" },
    "question_id": { "type": "string", "pattern": "^pubq_[0-9a-f]{24}$" },
    "cluster_id": { "type": "string", "pattern": "^pubc_[0-9a-f]{24}$" },
    "arm_id": { "type": "string", "pattern": "^pubarm_[0-9a-f]{16}$" },
    "grading_id": { "type": "string", "pattern": "^grade_[0-9a-f]{24}$" },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["selected_resource_ids", "packet_sha256", "restricted_source_sha256"],
      "properties": {
        "selected_resource_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^pubres_[0-9a-f]{24}$" }
        },
        "packet_sha256": { "$ref": "#/$defs/sha256" },
        "restricted_source_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "model", "server", "prompt_sha256", "schema_sha256", "reasoning_effort", "seed", "retry_policy"],
      "properties": {
        "provider": { "$ref": "#/$defs/nonempty" },
        "model": { "$ref": "#/$defs/nonempty" },
        "server": { "$ref": "#/$defs/nonempty" },
        "prompt_sha256": { "$ref": "#/$defs/sha256" },
        "schema_sha256": { "$ref": "#/$defs/sha256" },
        "reasoning_effort": { "$ref": "#/$defs/nonempty" },
        "seed": { "type": ["integer", "null"], "minimum": 0 },
        "retry_policy": { "$ref": "#/$defs/nonempty" }
      }
    },
    "outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["representation", "value", "answer_sha256"],
      "properties": {
        "representation": { "const": "categorical_score" },
        "value": { "enum": ["correct", "incorrect", "abstain", "excluded"] },
        "answer_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "grading": {
      "type": "object",
      "additionalProperties": false,
      "required": ["deterministic_grade", "panel_votes", "human_adjudication", "exclusion_reason"],
      "properties": {
        "deterministic_grade": { "type": ["integer", "null"], "enum": [0, 1, null] },
        "panel_votes": { "type": "array", "items": { "type": "integer", "enum": [0, 1] } },
        "human_adjudication": { "type": ["integer", "null"], "enum": [0, 1, null] },
        "exclusion_reason": { "type": ["string", "null"], "minLength": 1 }
      }
    },
    "economics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input_tokens", "cached_input_tokens", "output_tokens", "total_tokens", "provider_cost_usd", "latency_ms", "retry_count", "transport_failure_count"],
      "properties": {
        "input_tokens": { "$ref": "#/$defs/count" },
        "cached_input_tokens": { "$ref": "#/$defs/count" },
        "output_tokens": { "$ref": "#/$defs/count" },
        "total_tokens": { "$ref": "#/$defs/count" },
        "provider_cost_usd": { "type": ["number", "null"], "minimum": 0 },
        "latency_ms": { "$ref": "#/$defs/count" },
        "retry_count": { "$ref": "#/$defs/count" },
        "transport_failure_count": { "$ref": "#/$defs/count" }
      }
    },
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contains_raw_clinical_text", "omitted_fields", "omission_rationale", "review_status"],
      "properties": {
        "contains_raw_clinical_text": { "const": false },
        "omitted_fields": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/nonempty" } },
        "omission_rationale": { "$ref": "#/$defs/nonempty" },
        "review_status": { "enum": ["aggregate-and-identifiers-only", "approved-license-compatible-text"] }
      }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "nonempty": { "type": "string", "minLength": 1 },
    "count": { "type": "integer", "minimum": 0 }
  }
}
