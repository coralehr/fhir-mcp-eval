{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "A11b successor answer transport v2 (unsealed)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "status",
    "answer",
    "source_resource_ids",
    "evidence_summary",
    "insufficiency_reason"
  ],
  "properties": {
    "status": {
      "type": "string"
    },
    "answer": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 128
    },
    "source_resource_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 128
      },
      "maxItems": 16
    },
    "evidence_summary": {
      "type": "string",
      "maxLength": 1024
    },
    "insufficiency_reason": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 1024
    }
  }
}
