{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "A11b FHIR Agent Answer",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "answer",
    "source_resource_ids",
    "evidence_summary",
    "insufficiency_reason"
  ],
  "properties": {
    "answer": {
      "type": "string"
    },
    "source_resource_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^[A-Z][A-Za-z0-9]*/[A-Za-z0-9.-]{1,64}$"
      },
      "uniqueItems": true
    },
    "evidence_summary": {
      "type": "string",
      "minLength": 1
    },
    "insufficiency_reason": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "oneOf": [
    {
      "properties": {
        "answer": {
          "type": "string",
          "minLength": 1,
          "not": {
            "const": "Insufficient evidence."
          }
        },
        "source_resource_ids": {
          "minItems": 1
        },
        "insufficiency_reason": {
          "type": "null"
        }
      }
    },
    {
      "properties": {
        "answer": {
          "const": "Insufficient evidence."
        },
        "source_resource_ids": {
          "maxItems": 0
        },
        "insufficiency_reason": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  ]
}
